---
import logo from '../../assets/logo-dark.svg';
import Carousel from './Carousel.astro';

const installCommand = 'npx autoducks install';

const badges = ['Spec-driven', 'Ralph Loops', 'Backpressure', 'Deterministic Orchestration'];
---

<section class="hero not-content">
  <div class="hero__left">
    <img class="hero__mark" src={logo.src} width="72" height="72" alt="" aria-hidden="true" />

    <h1 class="hero__title">autoducks</h1>

    <p class="hero__tagline">
      Automates and orchestrates <strong>Claude Code</strong> inside your GitHub repository using
      GitHub Actions.
    </p>

    <ul class="hero__badges">
      {badges.map((badge) => <li class="hero__badge">{badge}</li>)}
    </ul>

    <div class="hero__install">
      <pre class="hero__snippet"><code>{installCommand}</code></pre>
      <button class="hero__copy" type="button" data-copy={installCommand} aria-label="Copy install command">
        <span class="hero__copy-label">Copy</span>
      </button>
    </div>
  </div>

  <div class="hero__right">
    <Carousel />
  </div>
</section>

<script is:inline>
  (function () {
    var button = document.querySelector('.hero__copy');
    if (!button) return;
    var label = button.querySelector('.hero__copy-label');
    button.addEventListener('click', function () {
      var text = button.getAttribute('data-copy') || '';
      if (!navigator.clipboard) return;
      navigator.clipboard.writeText(text).then(function () {
        if (!label) return;
        var original = label.textContent;
        label.textContent = 'Copied';
        button.classList.add('is-copied');
        setTimeout(function () {
          label.textContent = original;
          button.classList.remove('is-copied');
        }, 1600);
      });
    });
  })();
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: 3rem;
    margin: 1.5rem auto 5rem;
    max-width: 66rem;
    padding-inline: 1rem;
  }

  .hero__left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    text-align: left;
  }

  .hero__right {
    min-width: 0;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      max-width: 40rem;
    }

    .hero__left {
      align-items: center;
      text-align: center;
    }
  }

  .hero__mark {
    width: 4.5rem;
    height: 4.5rem;
    filter: drop-shadow(0 6px 18px rgba(31, 111, 235, 0.35));
  }

  .hero__title {
    margin: 0;
    font-size: clamp(2.75rem, 2rem + 3.5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    background: linear-gradient(120deg, var(--sl-color-white), var(--sl-color-accent-high));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__tagline {
    margin: 0;
    max-width: 36rem;
    font-size: clamp(1.05rem, 0.9rem + 0.7vw, 1.4rem);
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }

  .hero__tagline strong {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.5rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__badge {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-family: var(--__sl-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .hero__install {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
    width: 100%;
    max-width: 26rem;
    margin-top: 0.5rem;
  }

  .hero__snippet {
    display: flex;
    align-items: center;
    flex: 1 1 auto;
    min-width: 0;
    margin: 0;
    padding: 0.7rem 1rem;
    overflow-x: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-1);
    font-family: var(--__sl-font-mono);
    font-size: 0.9rem;
    text-align: left;
    white-space: pre;
  }

  .hero__snippet code {
    background: transparent;
    padding: 0;
    border: none;
    color: inherit;
    font: inherit;
  }

  .hero__snippet code::before {
    content: '$ ';
    color: var(--sl-color-gray-3);
  }

  .hero__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0 0.85rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-size: 0.8rem;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .hero__copy:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  .hero__copy.is-copied {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__copy {
      transition: none;
    }
  }
</style>
