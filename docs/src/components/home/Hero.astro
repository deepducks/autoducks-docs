---
import logo from '../../assets/logo-dark.svg';
import Carousel from './Carousel.astro';

const badges = ['Spec-driven', 'Ralph Loops', 'Backpressure', 'Deterministic Orchestration'];
---

<section class="hero not-content">
  <div class="hero__left">
    <img class="hero__mark" src={logo.src} width="72" height="72" alt="" aria-hidden="true" />

    <h1 class="hero__title">autoducks</h1>

    <p class="hero__tagline">
      Automates and orchestrates <strong>Claude Code</strong> inside your GitHub repository using
      GitHub Actions.
    </p>

    <ul class="hero__badges">
      {badges.map((badge) => <li class="hero__badge">{badge}</li>)}
    </ul>

    <div class="hero__cta">
      <a class="hero__btn hero__btn--primary" href="https://github.com/apps/autoducks/installations/new">
        <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
        Install in GitHub
      </a>
      <a class="hero__btn hero__btn--ghost" href="/getting-started/introduction/">
        View docs
        <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true"><path d="M5 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>
  </div>

  <div class="hero__right">
    <Carousel />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: 3rem;
    margin: 1.5rem auto 5rem;
    max-width: 66rem;
    padding-inline: 1rem;
  }

  .hero__left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    text-align: left;
  }

  .hero__right {
    min-width: 0;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      max-width: 40rem;
    }

    .hero__left {
      align-items: center;
      text-align: center;
    }
  }

  .hero__mark {
    width: 4.5rem;
    height: 4.5rem;
    filter: drop-shadow(0 6px 18px rgba(31, 111, 235, 0.35));
  }

  .hero__title {
    margin: 0;
    font-size: clamp(2.75rem, 2rem + 3.5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    background: linear-gradient(120deg, var(--sl-color-white), var(--sl-color-accent-high));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__tagline {
    margin: 0;
    max-width: 36rem;
    font-size: clamp(1.05rem, 0.9rem + 0.7vw, 1.4rem);
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }

  .hero__tagline strong {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 0.5rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .hero__badge {
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-family: var(--__sl-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.6rem;
  }

  .hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.62rem 1.15rem;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: filter 0.15s ease, border-color 0.15s ease, color 0.15s ease,
      background 0.15s ease;
  }

  .hero__btn svg {
    flex: none;
  }

  .hero__btn--primary {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: #fff;
  }

  .hero__btn--primary:hover {
    filter: brightness(1.12);
  }

  .hero__btn--ghost {
    background: var(--sl-color-gray-6);
    border-color: var(--sl-color-gray-5);
    color: var(--sl-color-gray-1);
  }

  .hero__btn--ghost:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__btn {
      transition: none;
    }
  }
</style>
