---
import { Icon } from '@astrojs/starlight/components';
import { PLUGINS } from '../../lib/home/ducks';

const Tag = 'div';
---

<section class="plugins not-content">
  <header class="plugins__header">
    <h2 class="plugins__title"><span class="grad-word">Plugins</span></h2>
    <p class="plugins__lede">Because every tool needs extensibility.</p>
  </header>

  <ul class="plugins__grid">
    {
      PLUGINS.map((plugin) => {
        const isLink = Boolean(plugin.href);
        const El = isLink ? 'a' : Tag;
        return (
          <li>
            <El
              class:list={['plugin', { 'plugin--soon': plugin.status === 'soon' }]}
              href={plugin.href}
              style={`--plugin-accent: ${plugin.accent}`}
            >
              <span class="plugin__top">
                <span class="plugin__icon"><Icon name={plugin.icon} /></span>
                {plugin.status === 'soon' && <span class="plugin__badge">Soon</span>}
              </span>
              <h3 class="plugin__name">{plugin.name}</h3>
            </El>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .plugins {
    margin: 10rem auto;
    max-width: 74rem;
    padding-inline: 1rem;
  }

  .plugins__header {
    max-width: 42rem;
    margin: 0 auto 2rem;
    text-align: center;
  }

  .plugins__title {
    margin: 0 0 0.9rem;
    color: var(--sl-color-white);
    font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
    font-weight: 600;
  }

  .plugins__title::after {
    content: '';
    display: block;
    width: 2.5rem;
    height: 3px;
    margin: 0.9rem auto 0;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--sl-color-accent), var(--sl-color-accent-high));
  }

  .plugins__lede {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 1rem;
    line-height: 1.6;
  }

  .plugins__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .plugins__grid > li {
    flex: 1 1 15rem;
    max-width: 18rem;
  }

  .plugin {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.3rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-6);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  a.plugin:hover {
    border-color: var(--plugin-accent);
    transform: translateY(-3px);
  }

  a.plugin:focus-visible {
    outline: 2px solid var(--plugin-accent);
    outline-offset: 2px;
  }

  .plugin--soon {
    opacity: 0.72;
  }

  .plugin__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .plugin__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--plugin-accent) 16%, transparent);
    color: var(--plugin-accent);
  }

  .plugin__icon :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .plugin__badge {
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 999px;
    color: var(--sl-color-gray-3);
    font-family: var(--__sl-font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .plugin__name {
    margin: 0;
    color: var(--sl-color-white);
    font-size: 1.05rem;
    font-weight: 600;
  }

  .plugin__desc {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .plugin {
      transition: none;
    }

    a.plugin:hover {
      transform: none;
    }
  }
</style>
