---
import type { Duck } from '../../lib/home/ducks';

interface Props {
  duck: Duck;
}

const { duck } = Astro.props;
const modes = [duck.primary, duck.secondary];

/* Transformation illustrations: a muted "input → output" schematic where the
   accent lands only on the element that matters (the tags, the checks, the
   waves, the result). Keyed by role so the card content stays untouched.
   Shared connectors: a straight arrow, and a two-arc loop for the looping ducks. */
const AR =
  '<path class="in" d="M28 14h6.4"/><path class="in" d="M31.4 10.9l3.2 3.1-3.2 3.1"/>';
const LOOP =
  '<path class="in" d="M28.6 11.6a4 4 0 0 1 6.8-.5"/><path class="in" d="M35.7 8.6l-.3 2.6-2.6-.5"/>' +
  '<path class="in" d="M35.4 16.4a4 4 0 0 1-6.8 .5"/><path class="in" d="M28.3 19.4l.3-2.6 2.6 .5"/>';

const DIAGRAMS: Record<string, string> = {
  // list → Feature (blue) / Bug (red) tags
  'Product Owner':
    '<path class="in" d="M4 8h18"/><path class="in" d="M4 14h18"/><path class="in" d="M4 20h12"/>' + AR +
    '<rect class="of-feat" x="42" y="5.6" width="8" height="4.8" rx="1.5"/><path class="in" d="M52 8h10"/>' +
    '<rect class="of-bug" x="42" y="11.6" width="8" height="4.8" rx="1.5"/><path class="in" d="M52 14h10"/>' +
    '<path class="in" d="M42 20h14"/>',
  // draft → spec (the spec is the focus)
  Architect:
    '<path class="in" d="M4 9h11"/><path class="in" d="M6 14h9"/><path class="in" d="M4 19h13"/>' + AR +
    '<rect class="out" x="42" y="5" width="16" height="18" rx="2"/><path class="out" d="M45.5 10h9" stroke-width="2.6"/>' +
    '<path class="in" d="M45.5 14h9"/><path class="in" d="M45.5 17.5h6"/>',
  // spec → subtasks (the checks are the focus)
  Engineer:
    '<rect class="in" x="4" y="5" width="16" height="18" rx="2"/><path class="in" d="M7.5 10h9"/><path class="in" d="M7.5 14h9"/><path class="in" d="M7.5 18h5.5"/>' + AR +
    '<path class="out" d="M42 8l1.6 1.6 2.6-2.8"/><path class="in" d="M49 8h13"/>' +
    '<path class="out" d="M42 14l1.6 1.6 2.6-2.8"/><path class="in" d="M49 14h13"/>' +
    '<path class="out" d="M42 20l1.6 1.6 2.6-2.8"/><path class="in" d="M49 20h9"/>',
  // stacked subtasks → parallel waves (the waves are the focus)
  Maestro:
    '<rect class="in" x="4" y="6.5" width="16" height="4" rx="1.4"/><rect class="in" x="4" y="12" width="16" height="4" rx="1.4"/><rect class="in" x="4" y="17.5" width="16" height="4" rx="1.4"/>' + AR +
    '<path class="out" d="M42 8h15"/><path class="out" d="M54.5 5.5l2.5 2.5-2.5 2.5"/>' +
    '<path class="out" d="M42 14h18"/><path class="out" d="M57.5 11.5l2.5 2.5-2.5 2.5"/>' +
    '<path class="out" d="M42 20h11"/><path class="out" d="M50.5 17.5l2.5 2.5-2.5 2.5"/>',
  // failing → passing check (the check is the focus), looping
  Developer:
    '<rect class="in" x="5" y="7" width="14" height="14" rx="2"/><path class="in" d="M9.5 11.5l5 5"/><path class="in" d="M14.5 11.5l-5 5"/>' + LOOP +
    '<rect class="in" x="45" y="7" width="14" height="14" rx="2"/><path class="out" d="M48 14l2.6 2.6 5.4-5.9" stroke-width="1.9"/>',
  // two conflicting versions → merged result (the merge is the focus)
  Resolver:
    '<rect class="in" x="3" y="8" width="8" height="10" rx="1.5"/><rect class="in" x="13" y="8" width="8" height="10" rx="1.5"/><path class="in" d="M10.5 11.5l3 3"/><path class="in" d="M13.5 11.5l-3 3"/>' + AR +
    '<rect class="out" x="44" y="7" width="16" height="14" rx="1.8"/><path class="out" d="M48 14l2.2 2.2 5-5"/>',
  // diff → review comment + approval (the review is the focus)
  Reviewer:
    '<rect class="in" x="4" y="5" width="16" height="18" rx="2"/><path class="in" d="M7.5 10h6"/><path class="in" d="M7.5 14h8"/><path class="in" d="M7.5 18h5"/><path class="in" d="M15.6 9.9h2.6"/><path class="in" d="M16.9 8.6v2.6"/>' + AR +
    '<path class="out" d="M42 6.5h18.7a1.3 1.3 0 0 1 1.3 1.3v7.4a1.3 1.3 0 0 1-1.3 1.3H50l-4 3v-3h-4a1.3 1.3 0 0 1-1.3-1.3V7.8A1.3 1.3 0 0 1 42 6.5Z"/><path class="out" d="M46 10.6l2.2 2.2 4.6-4.4"/>',
  // change-request comment → approved code (the approval is the focus), looping
  Reworker:
    '<path class="in" d="M4 6h16a1.3 1.3 0 0 1 1.3 1.3v7a1.3 1.3 0 0 1-1.3 1.3h-7l-4 3v-3H4a1.3 1.3 0 0 1-1.3-1.3v-7A1.3 1.3 0 0 1 4 6Z"/><path class="in" d="M12 9v3.2" stroke-width="2"/><path class="in" d="M12 14.4v.1" stroke-width="2"/>' + LOOP +
    '<rect class="in" x="45" y="7" width="14" height="14" rx="2"/><path class="out" d="M48 14l2.6 2.6 5.4-5.9" stroke-width="1.9"/>',
};

const diagram = DIAGRAMS[duck.role] ?? '';
---

<a class="duck" href={duck.href} style={`--duck-accent: ${duck.accent}`}>
  {diagram && (
    <div class="duck__illo">
      <svg
        class="duck__diagram"
        viewBox="0 0 64 28"
        fill="none"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={diagram}
      />
    </div>
  )}

  <div class="duck__header">
    <h3 class="duck__label">{duck.label}</h3>
    <span class="duck__role">{duck.role}</span>
  </div>

  <dl class="duck__modes">
    {
      modes.map((mode) => (
        <Fragment>
          <dt class="duck__term">{mode.term}</dt>
          <dd class="duck__desc">
            {mode.desc && <span class="duck__desc-text" set:html={mode.desc} />}
            {mode.commands && mode.commands.length > 0 && (
              <span class="duck__cmds">
                {mode.commands.map((cmd) => (
                  <code>/{cmd}</code>
                ))}
              </span>
            )}
          </dd>
        </Fragment>
      ))
    }
  </dl>
</a>

<style>
  .duck {
    /* Feature / Bug are semantic (not the duck accent) — legible on both themes */
    --feat: #388bfd;
    --bug: #f85149;
    position: relative;
    display: flex;
    height: 100%;
    flex-direction: column;
    padding: 1.4rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-6);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  :root[data-theme='light'] .duck {
    --feat: #0969da;
    --bug: #cf222e;
  }

  .duck:hover {
    border-color: var(--duck-accent);
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
  }

  .duck:focus-visible {
    outline: 2px solid var(--duck-accent);
    outline-offset: 2px;
  }

  /* transformation illustration: bigger + centered, on a faint accent band */
  .duck__illo {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3.9rem;
    margin-bottom: 1.1rem;
    padding: 0 0.7rem;
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--duck-accent) 8%, transparent);
  }

  .duck__diagram {
    height: 2.35rem;
    width: auto;
    display: block;
  }

  /* injected via set:html, so it isn't scoped — reach it with :global() */
  .duck__illo :global(.in) {
    stroke: var(--sl-color-gray-3);
  }
  .duck__illo :global(.out) {
    stroke: var(--duck-accent);
  }
  .duck__illo :global(.of) {
    fill: var(--duck-accent);
    stroke: none;
  }
  .duck__illo :global(.of-feat) {
    fill: var(--feat);
    stroke: none;
  }
  .duck__illo :global(.of-bug) {
    fill: var(--bug);
    stroke: none;
  }

  .duck__header {
    margin-bottom: 0.9rem;
  }

  .duck__label {
    margin: 0;
    color: var(--duck-accent);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .duck__role {
    display: block;
    margin-top: 0.15rem;
    color: var(--sl-color-gray-3);
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .duck__modes {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.85rem;
    row-gap: 0.5rem;
    margin: 0;
    padding-top: 0.85rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .duck__term {
    color: var(--sl-color-gray-3);
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .duck__desc {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .duck__desc :global(strong) {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .duck__cmds {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .duck__cmds code {
    border-radius: 0.3rem;
    background: var(--sl-color-gray-5);
    padding: 0.1rem 0.4rem;
    color: var(--sl-color-gray-1);
    font-family: var(--__sl-font-mono);
    font-size: 0.72rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .duck {
      transition: none;
    }

    .duck:hover {
      transform: none;
    }
  }
</style>
