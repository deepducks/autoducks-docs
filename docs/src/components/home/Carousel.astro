---
import boardDark from '../../assets/home/board-cta-dark.png';
import boardLight from '../../assets/home/board-cta-light.png';

// Slides shown in the hero. The board slide uses the real screenshot; the
// GitHub and wizard slides are lightweight CSS mockups standing in for the
// eventual GIFs. Drop an <img> into their slide to swap in a real capture.
const slides = [
  { label: 'Trigger from a GitHub comment' },
  { label: 'Set up in the browser' },
  { label: 'Watch the board move' },
];
---

<div class="carousel" data-carousel>
  <div class="carousel__frame">
    <div class="carousel__bar" aria-hidden="true">
      <span class="carousel__light"></span>
      <span class="carousel__light"></span>
      <span class="carousel__light"></span>
    </div>

    <div class="carousel__viewport">
      <div class="carousel__slide is-active" data-slide role="group" aria-label={slides[0].label}>
        <div class="mock mock--github">
          <div class="mock__line">
            <span class="mock__avatar"></span>
            <span class="mock__meta"><strong>you</strong> commented</span>
          </div>
          <div class="mock__bubble"><code>/execute</code> model:opus effort:high</div>
          <div class="mock__line">
            <span class="mock__avatar mock__avatar--bot">🦆</span>
            <span class="mock__meta"><strong>autoducks</strong> started the pipeline</span>
          </div>
        </div>
      </div>

      <div class="carousel__slide" data-slide role="group" aria-label={slides[1].label}>
        <div class="mock mock--wizard">
          <div class="wz__head"><span class="wz__duck">🦆</span><span class="wz__title">Set up autoducks</span></div>
          <div class="wz__repo">deepducks/store</div>
          <div class="wz__row"><span class="wz__dot" style="--d:#a836e5"></span>Design features<span class="wz__sw is-on"></span></div>
          <div class="wz__row"><span class="wz__dot" style="--d:#28a745"></span>Parallel waves<span class="wz__sw is-on"></span></div>
          <div class="wz__row"><span class="wz__dot" style="--d:#58a6ff"></span>Review PRs<span class="wz__sw is-on"></span></div>
          <button class="wz__cta" type="button" tabindex="-1">Create setup PR</button>
        </div>
      </div>

      <div class="carousel__slide" data-slide role="group" aria-label={slides[2].label}>
        <img
          class="carousel__img carousel__img--dark"
          src={boardDark.src}
          width={boardDark.width}
          height={boardDark.height}
          alt="An autoducks board with example issues across pipeline columns"
          loading="lazy"
          decoding="async"
        />
        <img
          class="carousel__img carousel__img--light"
          src={boardLight.src}
          width={boardLight.width}
          height={boardLight.height}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>

  <div class="carousel__nav" role="tablist" aria-label="Hero preview">
    {
      slides.map((slide, index) => (
        <button
          class:list={['carousel__pip', { 'is-active': index === 0 }]}
          type="button"
          data-goto={index}
          role="tab"
          aria-label={slide.label}
          aria-current={index === 0 ? 'true' : 'false'}
        />
      ))
    }
  </div>
</div>

<script is:inline>
  (function () {
    var root = document.querySelector('[data-carousel]');
    if (!root) return;

    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-slide]'));
    var pips = Array.prototype.slice.call(root.querySelectorAll('.carousel__pip'));
    if (!slides.length) return;

    var current = 0;
    var timer = null;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function show(index) {
      current = (index + slides.length) % slides.length;
      slides.forEach(function (slide, i) {
        slide.classList.toggle('is-active', i === current);
      });
      pips.forEach(function (pip, i) {
        var active = i === current;
        pip.classList.toggle('is-active', active);
        pip.setAttribute('aria-current', active ? 'true' : 'false');
      });
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function start() {
      if (reduce) return;
      stop();
      timer = setInterval(function () {
        show(current + 1);
      }, 4200);
    }

    pips.forEach(function (pip, i) {
      pip.addEventListener('click', function () {
        show(i);
        start();
      });
    });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    show(0);
    start();
  })();
</script>

<style>
  .carousel {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    width: 100%;
  }

  .carousel__frame {
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-6);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.24);
  }

  .carousel__bar {
    display: flex;
    gap: 0.4rem;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-7);
  }

  .carousel__light {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 999px;
    background: var(--sl-color-gray-4);
  }

  .carousel__viewport {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--sl-color-gray-7);
  }

  .carousel__slide {
    position: absolute;
    inset: 0;
    display: flex;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s ease, visibility 0.5s ease;
  }

  .carousel__slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .carousel__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* theme-aware board variant */
  .carousel__img--light {
    display: none;
  }
  :global(:root[data-theme='light']) .carousel__img--dark {
    display: none;
  }
  :global(:root[data-theme='light']) .carousel__img--light {
    display: block;
  }

  /* ── mockups ── */
  .mock {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    padding: 1.5rem clamp(1rem, 4%, 2rem);
    font-family: var(--__sl-font-mono);
    font-size: clamp(0.72rem, 0.6rem + 0.4vw, 0.9rem);
  }

  .mock--github {
    background: radial-gradient(120% 120% at 0% 0%, var(--sl-color-gray-6), var(--sl-color-gray-7));
  }

  .mock__line {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--sl-color-gray-2);
  }

  .mock__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 999px;
    background: var(--sl-color-gray-4);
    font-size: 0.8rem;
  }

  .mock__avatar--bot {
    background: color-mix(in srgb, var(--sl-color-accent) 25%, transparent);
  }

  .mock__meta strong {
    color: var(--sl-color-white);
  }

  .mock__bubble {
    margin-left: 1.95rem;
    padding: 0.6rem 0.85rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
  }

  .mock__bubble code {
    padding: 0.1rem 0.4rem;
    border-radius: 0.3rem;
    background: color-mix(in srgb, var(--sl-color-accent) 18%, transparent);
    color: var(--sl-color-accent-high);
    font: inherit;
  }

  .mock--wizard {
    gap: 0.5rem;
    align-items: stretch;
    font-family: var(--__sl-font, system-ui, sans-serif);
    background: radial-gradient(130% 130% at 100% 0%, var(--sl-color-gray-6), var(--sl-color-black));
  }

  .wz__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .wz__title {
    color: var(--sl-color-white);
    font-weight: 600;
  }

  .wz__repo {
    align-self: flex-start;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
    font-size: 0.85em;
  }

  .wz__row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-1);
  }

  .wz__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--d);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--d) 22%, transparent);
    flex: none;
  }

  .wz__sw {
    position: relative;
    margin-left: auto;
    width: 1.8rem;
    height: 1rem;
    border-radius: 999px;
    background: var(--sl-color-gray-4);
    flex: none;
  }

  .wz__sw.is-on {
    background: var(--sl-color-accent);
  }

  .wz__sw::after {
    content: '';
    position: absolute;
    top: 0.15rem;
    right: 0.15rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    background: #fff;
  }

  .wz__cta {
    align-self: flex-start;
    margin-top: 0.1rem;
    padding: 0.45rem 0.9rem;
    border: none;
    border-radius: 0.5rem;
    background: var(--sl-color-accent);
    color: #fff;
    font: inherit;
    font-weight: 600;
    font-size: 0.9em;
  }

  /* ── nav pips ── */
  .carousel__nav {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }

  .carousel__pip {
    width: 0.55rem;
    height: 0.55rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: var(--sl-color-gray-4);
    cursor: pointer;
    transition: width 0.2s ease, background-color 0.2s ease;
  }

  .carousel__pip.is-active {
    width: 1.4rem;
    background: var(--sl-color-accent);
  }

  .carousel__pip:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__slide {
      transition: none;
    }

    .carousel__pip {
      transition: none;
    }
  }
</style>
